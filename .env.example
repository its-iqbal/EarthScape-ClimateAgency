# ==============================================================================
# EarthScape Climate Intelligence Platform — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust values if running on a custom infrastructure.

# MongoDB Connection (Default: local community server on port 27017)
MONGO_URI=mongodb://localhost:27017/
DATABASE_NAME=earthscape_climate

# Flask Backend Server
FLASK_ENV=development
PORT=5000

# Authentication & JWT Security
JWT_SECRET=earthscape-super-secret-climate-key-2024
JWT_EXPIRATION_HOURS=24
