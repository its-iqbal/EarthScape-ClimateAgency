# ==============================================================================
# EarthScape Climate Agency — Git Ignore Rules
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend dependencies & builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment & Secrets (Never commit production credentials)
.env
.env.local
.env.*.local
*.pem
*.key

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-workspace
*.swp
*~

# Temporary & Cache Storage
*.tmp
.cache/
data/backups/

